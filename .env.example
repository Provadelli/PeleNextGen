# Copie este arquivo para ".env" e preencha com os valores do seu projeto Supabase.
# NUNCA commite o arquivo ".env" com valores reais — ele já está no .gitignore.

# Supabase (obrigatório para o app subir)
SUPABASE_PROJECT_ID="<seu-project-id>"
SUPABASE_PUBLISHABLE_KEY="<sua-anon-key>"
SUPABASE_URL="https://<seu-projeto>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<seu-project-id>"
VITE_SUPABASE_PUBLISHABLE_KEY="<sua-anon-key>"
VITE_SUPABASE_URL="https://<seu-projeto>.supabase.co"

# Necessárias apenas para funcionalidades específicas de server (login, wearables etc).
# Em produção (Cloudflare), configure via `wrangler secret put <NOME>` — nunca em wrangler.jsonc.
# Em dev local, coloque estas mesmas linhas (sem comentário) em um arquivo ".dev.vars" (já no .gitignore).
# SUPABASE_SERVICE_ROLE_KEY="" # client.server.ts, wearables.server.ts, edge function delete-user
# GOOGLE_FIT_CLIENT_ID=""      # OAuth do Google Fit (conexão de wearables)
# GOOGLE_FIT_CLIENT_SECRET=""  # OAuth do Google Fit (conexão de wearables)
