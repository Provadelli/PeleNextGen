# Copie para `.env` (cp .env.example .env) e preencha. O `.env` NUNCA deve ser commitado.

# --- Supabase (públicas: vão para o navegador, protegidas por RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase para server functions / SSR ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- SEGREDOS (somente servidor) ---
# Em dev local, prefira o arquivo `.dev.vars`; em produção use `wrangler secret put <NOME>`
# ou as Environment Variables da Vercel. Nunca coloque em arquivos versionados.
SUPABASE_SERVICE_ROLE_KEY=      # src/server/*, edge function delete-user
GOOGLE_FIT_CLIENT_ID=           # OAuth do Google Fit (wearables)
GOOGLE_FIT_CLIENT_SECRET=
CRON_SECRET=                    # Authorization: Bearer <CRON_SECRET> em /api/public/hooks/sync-wearables

# --- Somente para scripts-test.ts (formato email:senha,email:senha) ---
TEST_USERS=
